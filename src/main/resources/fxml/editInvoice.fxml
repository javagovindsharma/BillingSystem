<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.djtraders.billing.controller.EditInvoiceController"
      stylesheets="@../css/editInvoice.css"
      spacing="15"
      styleClass="form-container">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="View Invoice"
           styleClass="form-title"/>

    <!-- Header Section -->
    <GridPane hgap="15" vgap="15">

        <columnConstraints>
            <ColumnConstraints prefWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>

            <ColumnConstraints prefWidth="80"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Invoice Number -->
        <Label text="Invoice No"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtInvoiceNo"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <!-- Date -->
        <Label text="Date"
               GridPane.rowIndex="0"
               GridPane.columnIndex="2"/>

        <TextField fx:id="txtDate"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="3"/>

        <!-- Seller Label -->
        <Label text="Seller Address"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <!-- Buyer Label -->
        <Label text="Buyer Address"
               GridPane.rowIndex="1"
               GridPane.columnIndex="2"/>

        <!-- Seller Address -->
        <TextArea fx:id="txtSeller"
                  prefRowCount="5"
                  wrapText="true"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="0"
                  GridPane.columnSpan="2"/>

        <!-- Buyer Address -->
        <TextArea fx:id="txtBuyer"
                  prefRowCount="5"
                  wrapText="true"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="2"
                  GridPane.columnSpan="2"/>

    </GridPane>

    <!-- Item Table -->
    <TableView fx:id="itemTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="snCol"
                         text="S.No."
                         prefWidth="70"/>

            <TableColumn fx:id="nameCol"
                         text="Product Name"
                         prefWidth="200"/>

            <TableColumn fx:id="hsnCol"
                         text="HSN"
                         prefWidth="100"/>

            <TableColumn fx:id="qtyCol"
                         text="Qty"
                         prefWidth="80"/>

            <TableColumn fx:id="rateCol"
                         text="Rate"
                         prefWidth="100"/>

            <TableColumn fx:id="mrpCol"
                         text="MRP"
                         prefWidth="100"/>

            <TableColumn fx:id="discountCol"
                         text="Discount"
                         prefWidth="100"/>

            <TableColumn fx:id="amountCol"
                         text="Amount"
                         prefWidth="120"/>

        </columns>

    </TableView>

    <!-- Buttons -->
    <HBox spacing="10"
          alignment="CENTER_RIGHT">

        <Button text="Save Changes"
                onAction="#saveInvoice"
                styleClass="save-btn"/>

        <Button text="Cancel"
                onAction="#closeWindow"
                styleClass="cancel-btn"/>

    </HBox>

</VBox>