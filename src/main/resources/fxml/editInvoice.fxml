<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      stylesheets="@../css/editInvoice.css"
      fx:controller="com.djtraders.billing.controller.EditInvoiceController"
      spacing="20"
      alignment="CENTER"
      styleClass="form-container">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Edit Invoice"
           styleClass="form-title"/>

    <GridPane hgap="10" vgap="15">

        <Label text="Company Name"/>
        <TextField fx:id="txtCompany"
                   GridPane.columnIndex="1"/>

        <Label text="Email"
               GridPane.rowIndex="1"/>
        <TextField fx:id="txtEmail"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Status"
               GridPane.rowIndex="2"/>
        <ComboBox fx:id="cmbStatus"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="2"/>

        <Label text="Amount"
               GridPane.rowIndex="3"/>
        <TextField fx:id="txtAmount"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">

        <Button text="Cancel"
                onAction="#closeWindow"
                styleClass="cancel-btn"/>

        <Button text="Save Changes"
                onAction="#saveInvoice"
                styleClass="save-btn"/>

    </HBox>

</VBox>