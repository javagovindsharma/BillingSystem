<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.djtraders.billing.controller.InvoiceEntryController"
            stylesheets="@../css/invoiceEntry.css"
         >

    <center>

        <VBox spacing="15"
              styleClass="form-card">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Heading -->
            <Label text="TAX INVOICE"
                   styleClass="heading"  />

            <!-- Invoice Details -->
            <GridPane hgap="15" vgap="10">

                <Label text="Invoice No"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="invoiceNoField"
                           promptText="Invoice Number"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Invoice Date"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"/>

                <DatePicker fx:id="invoiceDatePicker"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="3"/>

            </GridPane>

            <!-- Seller / Buyer -->
            <HBox spacing="15">

                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Seller Details"/>
                    <TextArea fx:id="sellerDetailsField"
                              prefRowCount="4"
                              minHeight="120"
                              wrapText="true"
                              text="R.J. TRADERS&#10;DILDAR NAGAR BAZAR NEAR KRISHI MANDI GHAZIPUR&#10;Mob. 9161490408&#10;GST. 09AYMPJ1555D2ZE"/>

                </VBox>

                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Buyer Details"/>
                    <TextArea fx:id="buyerDetailsField"
                              wrapText="true"
                              minHeight="120"
                              prefRowCount="4"/>
                </VBox>

            </HBox>

            <!--  Product Grid -->
            <TitledPane text="Product Entry" expanded="true">

                <content>

                    <GridPane hgap="15" vgap="10">

                        <Label text="Product Name"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="productNameField"
                                   promptText="Enter Product Name"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="1"/>

                        <Label text="HSN"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="2"/>

                        <TextField fx:id="hsnField"
                                   promptText="HSN Code"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="3"/>

                        <Label text="MRP"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="mrpField"
                                   promptText="MRP"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="Qty"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="2"/>

                        <TextField fx:id="qtyField"
                                   promptText="Quantity"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="3"/>

                        <Label text="Rate"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="rateField"
                                   promptText="Rate"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="1"/>

                        <Label text="Discount %"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="2"/>

                        <TextField fx:id="discountField"
                                   promptText="Discount"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="3"/>

                    </GridPane>

                </content>

            </TitledPane>
            <!-- Product Table -->

            <HBox alignment="CENTER_RIGHT"
                  spacing="10">

                <Button text="Add Product"
                        onAction="#addProduct"
                        styleClass="success-btn"/>

                <Button text="Clear"
                        onAction="#clearProductFields"
                        styleClass="primary-btn"/>

            </HBox>

            <TableView fx:id="productTable"
                       prefHeight="350">

                <columns>

                    <TableColumn fx:id="snCol"
                                 text="S.N."
                                 prefWidth="60"/>

                    <TableColumn fx:id="nameCol"
                                 text="Product Name"
                                 prefWidth="250"/>

                    <TableColumn fx:id="hsnCol"
                                 text="HSN"
                                 prefWidth="120"/>

                    <TableColumn fx:id="mrpCol"
                                 text="MRP"
                                 prefWidth="90"/>

                    <TableColumn fx:id="qtyCol"
                                 text="Qty"
                                 prefWidth="80"/>

                    <TableColumn fx:id="rateCol"
                                 text="Rate"
                                 prefWidth="100"/>

                    <TableColumn fx:id="discountCol"
                                 text="Discount %"
                                 prefWidth="100"/>

                    <TableColumn fx:id="amountCol"
                                 text="Amount"
                                 prefWidth="150"/>

                    <TableColumn fx:id="actionCol"
                                 text="Action"
                                 prefWidth="150"/>

                </columns>

            </TableView>

            <!-- Grand Total -->

            <HBox alignment="CENTER_RIGHT"
                  spacing="10"
                  styleClass="total-box">

                <Label text="Grand Total :"
                       styleClass="total-label"/>

                <Label fx:id="grandTotalLabel"
                       text="₹ 0.00"
                       styleClass="total-label"/>

            </HBox>

            <!-- Footer Buttons -->

            <HBox spacing="10"
                  alignment="CENTER_RIGHT">

                <Button text="Generate PDF"
                        onAction="#generatePdf"
                        styleClass="primary-btn"/>

                <Button text="Save Invoice"
                        onAction="#saveInvoice"
                        styleClass="success-btn"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>